scenemute 4 ....x..x
scenedef 5 2 2 1 2 1 1 1 1
scenemute 5 ...x..x.
scenedef 6 1 1 1 1 1 1 1 1
scenemute 6 xx..xxxx
song 1:2 2:8 3:2 4:8 5:4 6:2
songloop 0

# ---- play the song (HOME, SELECT to the Song page, PLAY), and perform
knob 4 cut 70
knob 3 cut 90
tap HOME
turn SELECT 1
stats reset
wav loom_demo_pop.wav
tap PLAY
# intro 2: the hook opening
bars 1
knob 4 cut 96
bars 1
knob 4 cut 127
knob 3 cut 110
# verse 8
bars 8
# pre 2: the piano's filter closing into the chorus, a riser by the hook pitched up a little each half bar
knob 3 cut 96
knob 4 e3 66
bars 0.5
knob 4 e3 68
bars 0.5
knob 4 e3 70
knob 3 cut 84
bars 0.5
knob 4 e3 72
bars 0.375
knob 4 e3 64
knob 3 cut 110
knob 3 r 44
bars 0.125
# chorus 8: the arp on T6, a chord held each bar
play 6 C4 on 100
play 6 E4 on 100
play 6 G4 on 100
play 6 C4 off
play 6 E4 off
play 6 G4 off
bars 1
play 6 B3 on 100
play 6 D4 on 100
play 6 G4 on 100
play 6 B3 off
play 6 D4 off
play 6 G4 off
bars 1
play 6 C4 on 100
play 6 E4 on 100
play 6 A4 on 100
play 6 C4 off
play 6 E4 off
play 6 A4 off
bars 1
play 6 C4 on 100
play 6 F4 on 100
play 6 A4 on 100
