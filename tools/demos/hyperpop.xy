# ---- play the song (HOME, SELECT to the Song page, PLAY), and perform

knob 4 cut 64
tap HOME
turn SELECT 1
stats reset
wav loom_demo_hyperpop.wav
tap PLAY
# intro 4: the voice opening
bars 1
knob 4 cut 80
bars 1
knob 4 cut 96
bars 1
knob 4 cut 112
bars 1
knob 4 cut 127
# build 4: the chords' filter opening, the voice an octave up for the last bar
knob 3 cut 70
bars 1
knob 3 cut 80
bars 1
knob 3 cut 90
bars 1
knob 3 cut 100
knob 4 e3 76
bars 1
knob 4 e3 64
knob 3 cut 106
# drop 8: a jumble on the drums for the last beat
bars 7.75
throw jumble on perc
bars 0.25
throw jumble off perc
# break 4 (two passes of 2-bar patterns): stutter, octave, chop
bars 1.5
throw stutter on mel 4
bars 0.5
throw stutter off mel 4
bars 1
throw octave on mel
bars 0.5
throw octave off mel
throw chop on mel
bars 0.5
throw chop off mel
# build 2
bars 2
# drop 2 8, the arp on T5: the chord held each bar (latched), let go
play 5 F4 on 100
play 5 A4 on 100
play 5 C5 on 100
play 5 F4 off
play 5 A4 off
play 5 C5 off
bars 1
play 5 G4 on 100
play 5 B4 on 100
play 5 D5 on 100
play 5 G4 off
