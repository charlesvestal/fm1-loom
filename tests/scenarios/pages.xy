# first boot: every page on a drum track (T1) and a synth track (T3), the aux tracks, cards, a list
wait 300
expect page Steps
shot steps.png
turn SELECT 1
expect page Bar
wait 40
shot bar.png
tap HOME
expect page Arrange
wait 40
shot arrange.png
turn SELECT 1
expect page Song
wait 40
shot song.png
tap EDIT
expect page Engine
wait 40
shot drum_engine.png
turn SELECT 1
expect page Play
wait 40
shot drum_key.png
tap SEL
wait 40
shot drum_key_list.png
tap HOME
tap ENV
wait 40
shot drum_envelope.png
turn SELECT 1
expect page Filter
wait 40
shot drum_filter.png
spin ALGO 2
expect trk 3
tap EDIT
wait 40
shot engine.png
turn SELECT 1
wait 40
shot play.png
tap ENV
wait 40
shot envelope.png
turn SELECT 1
expect page Filter
wait 40
shot filter.png
turn SELECT 1
wait 40
shot envelope2.png
tap FX
expect page Character
wait 40
shot character.png
param 3 30 0
turn PRESET 2
expect par3.30 2
wait 40
shot character_fold.png
tap SEL
wait 40
shot character_list.png
tap HOME
turn SELECT 1
expect page Sends
wait 40
shot sends.png
turn SELECT 1
wait 40
shot fx_page1.png
turn SELECT 1
wait 40
shot fx_page2.png
tap SEL
wait 40
shot fx_list.png
tap HOME
tap LFO
spin K1 1
wait 40
shot lfo.png
turn SELECT 1
wait 40
shot lfo2.png
spin K1 -1
tap ARP
spin K1 1
wait 40
shot players.png
turn SELECT 1
wait 40
shot players2.png
turn SELECT 1
wait 40
shot players3.png
spin K1 -1
tap GLO
expect page Mix
wait 40
shot mix.png
turn SELECT 1
wait 40
shot master.png
turn SELECT 1
wait 40
shot master3.png
turn SELECT 1
expect page Setup
wait 40
shot setup.png
turn SELECT 1
expect page Debug
wait 40
shot status.png
# the help cards
tap SEQ
press SEQ
wait 1000
shot card_seq.png
release SEQ
expect page Steps
press REC
wait 1000
shot card_rec.png
release REC
expect playing 0
tap SEL
wait 40
shot list_steps.png
tap HOME
expect page Steps
# the aux tracks' pages
tap EDIT
spin ALGO 6
expect trk 9
wait 40
shot brain.png
turn SELECT 1
wait 40
shot brain_routing.png
spin ALGO 1
wait 40
shot punch.png
spin ALGO 1
expect trk 13
wait 40
shot weave_track.png
spin ALGO 1
expect trk 1
# the effects: FX's FX I and FX II pages (not tracks on ALGORITHM)
tap FX
turn SELECT 1
turn SELECT 1
wait 40
shot fx1.png
turn SELECT 1
wait 40
shot fx2.png
shot fx2_lush.png
# the reverb's SPU modes: the longest names on the page, its title and its list (from the plate: lush is the default)
turn PRESET -10
expect par12.0 4
turn PRESET 7
wait 40
expect par12.0 11
shot fx2_space_echo.png
turn PRESET 1
wait 40
shot fx2_chaos_echo.png
tap SEL
wait 40
shot fx2_list.png
tap HOME
turn PRESET -8
expect par12.0 4
expect trk 1
