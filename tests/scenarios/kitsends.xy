# a kit's sends are its keys' own (no track sends): FX's Sends page on T1 turns the selected key's (the snare, then
# the clap picked by its black key), PRESET steps the key, the kick stays dry; GLO's Mix has no sends for a kit
wait 300
expect trk 1
tapkey b1
expect par1.d2.send2 16
tap FX
turn SELECT 1
expect page Sends
wait 60
shot kit_sends.png
spin K1 30
expect par1.d2.send1 30
spin K2 20
expect par1.d2.send2 36
expect par1.d1.send1 0
expect par1.d1.send2 0
tapkey b4
spin K2 10
expect par1.d5.send2 34
expect par1.d2.send2 36
turn PRESET -1
spin K1 5
expect par1.d4.send1 5
wait 60
shot kit_sends_key.png
# EDIT's third page on a kit: Sends, the key's own (the same values as FX's)
tap EDIT
turn SELECT 2
expect page Sends
spin K2 4
expect par1.d4.send2 4
wait 60
shot kit_edit_sends.png
# from the WEAVE track, ARP goes back to the last track picked (as Mix's FX strips: ALGO passed T8 on the way)
turn ALGO 1
expect trk 2
turn ALGO 9
expect trk 13
tap ARP
expect trk 8
