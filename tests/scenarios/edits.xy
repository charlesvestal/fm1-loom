# edits the testers reported (docs/feedback-2026-10-21.md): clearing the scene playing (it hands over to the nearest
# other scene, or the only one starts again plain); song slots inserted and deleted while the song plays (the slot
# playing keeps playing); CLEAR LOCKS (undone; a kit's tunes stay) and PASTE (with the locks; never across kinds); SAVE with no slot; the MIDI channels
wait 300
bpm 120
# the scene playing cleared: scene 2 goes, scene 1 plays
scenedef 2 2
tap HOME
expect page Arrange
tapkey w1
wait 40
expect scene 2
expect used 3
key w1 down
wait 1100
expect ask 1
key w1 up
tap SEL
wait 40
expect used 1
expect scene 1
# the only scene cleared: it stays, plain
scenedef 1 3
scenemute 1 x
key w0 down
wait 1100
key w0 up
tap SEL
wait 40
expect used 1
expect scene 1
expect mute 0
# the song: S1 S2 S3, a bar each; slot 2 playing, a slot added before it (after slot 1): slot 2 now third, and plays on
scenedef 2 2
scenedef 3 3
song 1:1 2:1 3:1
turn SELECT 1
expect page Song
turn K1 -5
tap PLAY
bars 1.25
expect songpos 2
expect scene 2
tapkey w2
wait 40
expect songpos 3
expect scene 2
bars 1
expect songpos 4
expect scene 3
# slot 4 playing (S3), slot 4 deleted: the slot in its place next (none: back to slot 1)
turn K1 -5
turn K1 3
tap SEL
turn SELECT 6
shot song_del.png
tap SEL
wait 40
bars 1
expect songpos 1
expect scene 1
# the song is S1 S3 S2: slot 1 playing, deleted: S3 (now slot 1) next, then S2
turn K1 -5
tap SEL
turn SELECT 6
tap SEL
wait 40
expect scene 1
bars 1
expect songpos 1
expect scene 3
bars 1
expect songpos 2
expect scene 2
tap PLAY
# CLEAR LOCKS undone; PASTE brings the locks; a synth's pattern is not pasted on a kit
tap HOME
step 2 1 1 60 100
lock 2 1 1 e1 30
turn ALGO 1
expect trk 2
tap SEQ
tap SEL
turn SELECT 1
tap SEL
expect lane 2 1 e1 0
press HOME
tap REC
release HOME
expect lane 2 1 e1 1
tap SEL
turn SELECT 3
tap SEL
turn K1 1
wait 40
tap SEL
turn SELECT 5
shot paste_list.png
tap SEL
expect note 2 2 1 60
expect lane 2 2 e1 1
turn ALGO -1
expect trk 1
tap SEL
turn SELECT 4
tap SEL
wait 40
expect note 1 1 1 0
# a new project: track N on MIDI channel N; with every slot taken it has none, and SAVE saves to the slot SAVE TO
# shows (asking, as it holds another project)
projsave 1 one
projsave 2 two
projsave 3 three
projnew
wait 40
expect par1.51 1
expect par2.51 2
expect par8.51 8
expect sendnotes 1
expect dirty 1
tap SAVE
wait 40
expect ask 1
tap SEL
wait 40
expect ask 0
expect dirty 0
# a track's MIDI channel on its sound pages' SEL list (MIDI CHANNEL, the last row)
turn ALGO 1
tap EDIT
tap SEL
turn SELECT 20
turn ALGO 3
wait 40
expect par2.51 5
tap HOME
# MIDI CC 7 in: the level of the track on that channel (T3 on 3, a new project's)
projnew
midi B2 07 40
wait 40
expect par3.48 64
expect dirty 1
# COPY BAR onto the next bar (with its lock); a held step's COPY STEP onto another step held; PASTE LOCKS ONLY
projnew
step 2 1 1 60 100
step 2 1 3 64 100
lock 2 1 3 e1 30
turn ALGO 1
expect trk 2
tap SEQ
tap SEL
turn SELECT 4
tap SEL
tap OCT+
tap SEL
turn SELECT 5
tap SEL
wait 40
expect note 2 1 17 60
expect note 2 1 19 64
expect lane 2 1 e1 2
tap OCT-
key w2 down
tap SEL
turn SELECT 1
tap SEL
key w2 up
key w5 down
tap SEL
turn SELECT 1
tap SEL
key w5 up
wait 40
expect note 2 1 6 64
expect lane 2 1 e1 3
# the locks alone: onto a step with a note of its own, which stays
step 2 1 8 67 100
key w7 down
tap SEL
turn SELECT 3
tap SEL
key w7 up
wait 40
expect note 2 1 8 67
expect lane 2 1 e1 4
# a kit's pattern is not pasted onto a synth's steps
turn ALGO -1
expect trk 1
key w0 down
tap SEL
tap SEL
key w0 up
turn ALGO 1
key w9 down
tap SEL
turn SELECT 1
tap SEL
key w9 up
wait 40
expect note 2 1 10 0
# DOUBLE PATTERN: 32 steps, the first 16 again (with their locks)
projnew
step 2 1 1 60 100
lock 2 1 1 e1 30
turn ALGO 1
tap SEQ
tap SEL
turn SELECT 20
tap SEL
wait 40
expect note 2 1 17 60
expect lane 2 1 e1 2
# 32 scenes: OCT+ on Arrange puts 17-32 on the white keys; a key there makes scene 18; the header says it
projnew
tap HOME
expect page Arrange
tap OCT+
tapkey w1
wait 40
expect scene 18
shot scenes32.png
tap OCT-
tapkey w0
wait 40
expect scene 1
# Arrange's KNOB 4: the selected track's pattern in this scene
projnew
tap SEQ
tap HOME
turn ALGO 1
expect trk 2
turn K4 2
wait 40
shot arrange_pat.png
expect pat2 3
tap SEQ
expect page Steps
tap HOME
# a kit step's sounds each their velocity: the snare shown, KNOB 1 on the held step turns its own; the kick keeps
# the step's; a step with one sound: the step's own
projnew
hits 1 1 1 x...............
hits 1 1 2 x...............
tap SEQ
expect trk 1
tapkey b1
key w0 down
turn K1 -50
key w0 up
wait 40
expect kvel1.1.1.2 50
expect kvel1.1.1.1 0
expect note 1 1 1 1
