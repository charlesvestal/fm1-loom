# C3 (docs/superpowers/specs/2026-10-21-midi-cc-map-design.md): fixed channels, the CC map in and out, scenes by MIDI
wait 300
# fixed channels: channel 3 is T3 whichever track is selected (T2 here); MIDI OUT on by default
projnew
expect par3.51 1
expect par2.51 1
turn ALGO 1
expect trk 2
out
midi 92 3C 64
wait 20
expect midi_out 1
expect_out USB 92 3C 64
out
midi 82 3C 00
wait 20
expect midi_out 2
expect_out USB 82 3C 00

# a track holding a channel number (as before C3) loads with MIDI OUT on
projnew
param 3 51 5
projsave 1
reboot
expect par3.51 1

# channel 12: the track selected (T2 after ALGO 1: its note goes out on its own channel 2, "91 3E");
# channels 9, 10 and 11: no notes
turn ALGO 1
expect trk 2
out
midi 9B 3E 64
wait 20
expect_out USB 91 3E 64
out
midi 8B 3E 00
wait 20
expect_out USB 81 3E 00
# the synth's release tail: T2's voice needs this long to die down after the note off, before "voices" reads 0
wait 300
midi 98 3C 64
midi 99 3C 64
midi 9A 3C 64
wait 20
expect voices 0
# MIDI OUT off on T3: no note out (the count stays)
param 3 51 0
expect midi_out 4
midi 92 40 64
wait 20
midi 82 40 00
wait 20
expect midi_out 4

# the map in: a synth (T2 on channel 2)
projnew
midi B1 07 40
midi B1 0A 00
midi B1 5B 7F
midi B1 5D 20
midi B1 4A 10
midi B1 47 7F
midi B1 49 05
midi B1 48 06
midi B1 4B 07
midi B1 05 08
midi B1 01 00
wait 40
expect par2.48 64
expect par2.49 0
expect par2.22 127
expect par2.23 32
expect par2.17 16
expect par2.18 127
expect par2.9 5
expect par2.12 6
expect par2.10 7
expect par2.6 8
expect par2.26 0
# a kit (T1 on channel 1): the bus's cuts, the kit's attack and length; 75 does nothing there
midi B0 4A 11
midi B0 47 12
midi B0 49 13
midi B0 48 14
midi B0 4B 15
wait 40
expect par1.20 17
expect par1.17 18
expect par1.10 19
expect par1.12 20
# TP_A ("lag" on a kit): untouched by 75, still its default
expect par1.9 0
# FX I on 9, FX II on 10
midi B8 07 21
midi B8 10 22
midi B8 13 23
midi B8 4A 24
midi B8 4B 25
midi B8 5D 26
midi B9 11 27
midi B9 5D 28
wait 40
expect par11.48 33
expect par11.1 34
expect epar11.1 34
expect par11.4 35
expect par11.17 36
expect par11.19 37
expect par11.23 38
expect par12.2 39
# the master on 11: level, EQ, a switch scaled (color type 0..2), release
midi BA 07 29
midi BA 10 2A
midi BA 14 7F
midi BA 1C 2B
wait 40
expect mst.level 41
expect mst.lo 42
expect mst.color 2
expect mst.release 43
midi BA 14 40
wait 40
expect mst.color 1
# rounding, on a range that isn't 0..127: color's 0..2 rounds 0x20 up to 1, 0x1F down to 0
midi BA 14 20
wait 40
expect mst.color 1
midi BA 14 1F
wait 40
expect mst.color 0
# recorded: REC held while playing, a CC on channel 3 writes T3's lane, not T2's (T2 selected); REC off records nothing
turn ALGO 1
tap PLAY
wait 300
press REC
wait 20
midi B2 07 10
wait 200
midi B2 07 70
wait 200
release REC
wait 20
midi B2 0A 20
wait 200
tap PLAY
expect lane 3 1 48 2
expect lane 2 1 48 0
expect lane 3 1 49 0

# channels 12-16 reach the track playing (inst_trk()), not just the one selected: play T3, then select an aux track
# (spin, not turn: a step at a time through T4..T8 would make T8 last_inst, not T3)
projnew
spin ALGO 2
expect trk 3
spin ALGO 6
expect trk 9
# eng_midi_trk follows inst_trk() once a frame (ui_frame)
wait 20
out
midi 9B 3C 64
wait 20
expect_out USB 92 3C 64
midi BB 07 50
wait 40
expect par3.48 80

# mutes as the Mix page's: T3 by CC 9, the kit's sound 2 by CC 17
projnew
midi B2 09 7F
wait 20
expect mute 4
midi B2 09 7F
wait 20
expect mute 4
midi B2 09 00
wait 20
expect mute 0
midi B0 11 7F
wait 20
expect kmute1 2
midi B0 11 00
wait 20
expect kmute1 0
# a kit sound's pan and level (sound 2: par 52 + 20 + 6 = 78, + 7 = 79)
midi B0 51 00
midi B0 67 5A
wait 20
expect par1.78 0
expect par1.79 90
# a kit's send I by an offset: sound 1's (par 70) and sound 2's (par 90) keep their gap
param 1 70 10
param 1 90 40
midi B0 5B 4A
wait 20
midi B0 5B 54
wait 20
expect par1.70 30
expect par1.90 60

# a kit's send I clamps at the send's top (127, DP_SEND1's range): coming back down loses what the clamp ate
midi B0 5B 40
wait 20
param 1 70 120
param 1 90 40
midi B0 5B 54
wait 20
expect par1.70 127
expect par1.90 60
midi B0 5B 40
wait 20
expect par1.70 107
expect par1.90 40

# CC 9 on a kit track (T1): its mute, as the Mix page's
midi B0 09 7F
wait 20
expect mute 1
midi B0 09 00
wait 20
expect mute 0

# CC OUT: on in a new project; a knob turned by hand sends its CC; a CC in sends nothing
projnew
turn ALGO 1
expect trk 2
tap GLO
expect page Mix
ccreset
turn K4 -1
wait 20
expect ccst 177
expect ccd1 7
ccreset
midi B1 07 40
wait 20
expect par2.48 64
expect ccouts 0
# MIDI OUT off on T2: its knob sends nothing
param 2 51 0
ccreset
turn K4 1
wait 20
expect ccouts 0
param 2 51 1
# the master's pump amount (Master out: GLO's fourth page, KNOB 4; MS_LEVEL itself is the SEL list's LEVEL row,
# not a knob there) on channel 11
turn SELECT 3
expect page Master_out
ccreset
turn K4 1
wait 20
expect ccst 186
expect ccd1 27
# the SEL list's LEVEL row (A_LEVEL), turned by hand: its CC too (six up: SCENES OUT and CC OUT come after it now)
ccreset
tap SEL
turn SELECT 40
turn SELECT -6
expect ccouts 0
ccreset
turn ALGO 1
wait 20
expect ccst 186
expect ccd1 7
# tap HOME closes the list (SEL on a PICK row doesn't: list_sel's A_LEVEL is a no-op)
tap HOME
expect page Master_out
# CC OUT off (GLO's SEL list: two up from the last row, SCENES OUT now sitting between it and ALL NOTES OFF): nothing sent
tap SEL
turn SELECT 40
turn SELECT -2
turn ALGO -1
tap HOME
expect page Master_out
ccreset
turn K4 1
wait 20
expect ccouts 0

# the exact value and channel: T2's level at 100, turned down by 1
projnew
turn ALGO 1
tap GLO
param 2 48 100
out
turn K4 -1
wait 20
expect par2.48 99
expect_out USB B1 07 63

# scaling on a non-0..127 range (CTYPE 0..2: 0->1 = 64, 1->2 = 127), and a knob past its end: no re-send
projnew
tap GLO
turn SELECT 2
expect page Master_color
out
turn K1 1
wait 20
expect_out USB BA 14 40
turn K1 1
wait 20
expect_out USB BA 14 7F
ccreset
turn K1 1
wait 20
expect ccouts 0

# scenes: Program Change and notes 36-67 on channel 11, as Arrange's white keys; SCENES OUT starts off
projnew
# scene 1 (a new project)

# a hand pick sends nothing with SCENES OUT off (the default): proves cc_out_scene checks the switch itself, not
# just the quiet flag (a MIDI pick would be quiet regardless, so that alone wouldn't prove it)
ccreset
tap HOME
expect page Arrange
tapkey w1
wait 40
expect scene 2                 # scene 2 (hand-picked)
expect ccouts 0                # SCENES OUT off: nothing sent

ccreset
midi CA 02
wait 40
expect scene 3                 # scene 3
midi 9A 25 64
wait 40
expect scene 2                 # scene 2
expect ccouts 0                # SCENES OUT off: nothing sent either way

# turn SCENES OUT on (GLO's SEL list, the row after CC OUT; tap HOME closes the list, tap SEL would not)
tap GLO
expect page Mix
tap SEL
turn SELECT 40
turn SELECT -1
turn ALGO 1
tap HOME
expect page Mix

# playing: cued for the next bar (SCENES SWITCH next bar); its landing stays quiet (came in over MIDI, SCENES OUT on)
ccreset
tap PLAY
wait 100
midi CA 04
wait 20
expect scene 2                 # scene 2 (still; the cue hasn't landed)
wait 2200
expect scene 5                 # scene 5
expect ccouts 0                # quiet: this scene came in over MIDI
tap PLAY

# a scene picked on the FM-1 goes out as its Program Change (scene 1: CA 00; 0xCA = 202), SCENES OUT on
ccreset
tap HOME
expect page Arrange
tapkey w0
wait 40
expect scene 1                 # scene 1
expect ccouts 1                # (ccreset doesn't clear the last packet: prove one really went out)
expect ccst 202
expect ccd1 0

# the two switches are independent: CC OUT off, SCENES OUT still on, a hand pick still sends its Program Change
tap GLO
expect page Mix
tap SEL
turn SELECT 40
turn SELECT -2
turn ALGO -1
tap HOME
expect page Mix
ccreset
tap HOME
expect page Arrange
tapkey w1
wait 40
expect scene 2                 # scene 2
expect ccouts 1                # CC OUT off doesn't touch SCENES OUT's own send
expect ccst 202
expect ccd1 1

# ignore rules (SCENES OUT on): none of these touch the scene playing or send anything
ccreset
midi CA 20                     # Program Change 32: out of range
wait 40
expect scene 2                 # scene 2 (unchanged)
expect ccouts 0
ccreset
midi 9A 44 64                  # note 68: out of range
wait 40
expect scene 2                 # scene 2 (unchanged)
expect ccouts 0
ccreset
midi 9A 23 64                  # note 35: below the range
wait 40
expect scene 2                 # scene 2 (unchanged)
expect ccouts 0
ccreset
midi 9A 25 00                  # note 37, velocity 0: a note off
wait 40
expect scene 2                 # scene 2 (unchanged)
expect ccouts 0
ccreset
midi C9 02                     # Program Change on channel 10, not the master's 11
wait 40
expect scene 2                 # scene 2 (unchanged)
expect ccouts 0
