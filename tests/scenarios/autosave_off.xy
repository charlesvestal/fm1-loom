# AUTOSAVE off (GLO's list): saved at once, then a change waits for SAVE; the setting kept over a restart
wait 300
tap GLO
tap SEL
turn SELECT 30
turn SELECT -2            /* AUTOSAVE: two up from the last row now CC OUT comes before ALL NOTES OFF */
wait 50
turn ALGO -1
wait 100
shot aoff_list.png
tap HOME
turn SELECT 4
wait 100
shot aoff_setup.png
expect dirty 0
tap SEQ
tapkey w2
wait 4500
expect dirty 1
reboot
wait 400
tap GLO
turn SELECT 4
wait 100
shot aoff_after_reboot.png
