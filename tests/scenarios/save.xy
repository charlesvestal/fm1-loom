# save and reboot: the beat, the tempo and the selected track survive
wait 200
tapkey w0
tapkey w4
tap HOME
spin K1 10
wait 50
expect tempo 130
expect dirty 1
tap SAVE
expect dirty 0
wait 40
shot saved.png
reboot
wait 300
expect note 1 1 1 1
expect note 1 1 5 1
expect tempo 130
expect dirty 0
press SAVE
tapkey w1
release SAVE
wait 100
shot save_slot.png
tap GLO
turn SELECT 4
tap SEL
wait 40
shot setup_list.png
tap HOME
