# PING WIDTH: the delay's bounce, its second extra on FX I's SEL list (WIDTH, a delay's); 127 (a new project's) hard left
# and right, 0 the echoes centred. Kept in the project
wait 300
projnew
expect par11.s1x2 127
expect par12.s1x2 48
expect epar11.s1x2 127
tap GLO
turn SELECT 1
wait 40
expect page FX_I
tap SEL
row WIDTH
turn ALGO -20
wait 40
shot pingwidth_list.png
tap SEL
wait 40
expect par11.s1x2 107
expect epar11.s1x2 107
# FX II is the reverb: no WIDTH there (its second extra its damp)
turn SELECT 1
wait 40
expect page FX_II
tap SEL
row LOW-PASS
wait 40
shot pingwidth_fx2.png
tap SEL
# kept by a save, a reboot and the load
projsave 1 pingwidth
reboot
wait 400
expect par11.s1x2 107
expect epar11.s1x2 107
