# projects: the autosave (stopped and quiet, 3 s after the last change), RENAME on the keys (OCT- capitals, OCT+ digits,
# G5 deletes), NEW PROJECT in the first free slot, the Song page's knobs on the slot just added (its bars the one before's)
wait 300
tapkey w0
expect dirty 1
wait 3500
expect dirty 0
# rename: HOME, SEL, RENAME (two rows down from LOAD PROJECT)
tap HOME
tap SEL
turn SELECT 2
wait 100
shot proj_list.png
tap SEL
wait 100
expect page Arrange
press OCT-
tapkey 1
release OCT-
tapkey 4
tapkey 4
tapkey 15
wait 50
press OCT+
tapkey 1
release OCT+
wait 50
shot proj_typing.png
tapkey 26
tapkey 4
tap SEL
wait 100
shot proj_named.png
wait 3500
expect dirty 0
# new project: slot 2 (slot 1 is taken)
tap SEL
turn SELECT 3
tap SEL
wait 100
tap SEL
wait 200
shot proj_new.png
# the song: two slots, the knobs on the second, its bars
tap HOME
wait 50
tapkey w0
tapkey w1
wait 50
shot proj_song.png
# RANDOMIZE PRESETS (after NEW PROJECT on HOME's list), asked first: T2 a bass, mono; T3 polyphonic; T5 a mono lead
tap SEL
turn SELECT 4
tap SEL
wait 100
shot proj_random_ask.png
tap SEL
wait 200
expect par2.vmode 1
expect par3.vmode 0
expect par5.vmode 1
expect par1.engine 8
expect dirty 1
