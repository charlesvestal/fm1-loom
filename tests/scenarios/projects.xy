# projects: the autosave (stopped and quiet, 3 s after the last change), RENAME on the keys (OCT- capitals, OCT+ digits,
# G5 deletes), NEW PROJECT in the first free slot, the Song page's knobs on the slot just added (its bars the one before's)
wait 300
tapkey w0
expect dirty 1
wait 3500
expect dirty 0
# HOME's list: the projects (a project is its slot: no names)
tap HOME
tap SEL
row LOAD PROJECT
wait 100
shot proj_list.png
tap HOME
wait 100
expect page Arrange
# new project: slot 2 (slot 1 is taken), asked first
tap SEL
row NEW PROJECT
tap SEL
wait 100
tap SEL
wait 200
shot proj_new.png
# the song: two slots, the knobs on the second, its bars
tap HOME
wait 50
tapkey w0
tapkey w1
wait 50
shot proj_song.png
# RANDOMIZE PRESETS (after NEW PROJECT on HOME's list), asked first: T2 a bass, mono; T3 polyphonic; T5 a mono lead
tap SEL
row RANDOMIZE PRESETS
tap SEL
wait 100
shot proj_random_ask.png
tap SEL
wait 200
expect par2.vmode 1
expect par3.vmode 0
expect par5.vmode 1
expect par1.engine 8
expect dirty 1
