# UX flow D: editing sounds: PRESETS stays in the engine, the LFO type resets, FX opens the character (PRESETS its
# type, each type's picture), then the sends; a drum key; a kit track's Character page
wait 300
turn ALGO 1
tap EDIT
turn PRESET 1
expect par2.0 0
wait 60
shot d02_next_preset.png
turn PRESET 10
expect par2.0 0
tap ENV
turn SELECT 1
expect page Filter
wait 60
shot d05_filter.png
turn PRESET 1
wait 60
shot d06_filter_type.png
tap LFO
spin K1 2
spin K4 -30
spin K1 1
expect par2.27 2
expect par2.26 64
wait 60
shot d09_lfo_random.png
# (the preset has a character of its own: from off, each type in turn)
param 2 30 0
tap FX
expect page Character
wait 60
shot d10a_character_off.png
turn PRESET 1
expect par2.30 1
wait 60
shot d10b_drive.png
spin K2 30
spin K3 -20
wait 60
shot d10c_drive_more.png
turn PRESET 1
expect par2.30 2
wait 60
shot d10d_fold.png
spin K3 30
wait 60
shot d10e_fold_bias.png
turn PRESET 1
expect par2.30 3
wait 60
shot d10f_crush.png
turn PRESET 1
expect par2.30 4
wait 60
shot d10g_ring.png
turn PRESET 1
expect par2.30 5
wait 60
shot d10h_tilt.png
spin K4 -40
wait 60
shot d10j_tilt_half_mix.png
turn PRESET 1
expect par2.30 6
wait 60
shot d10k_tape.png
turn PRESET 1
expect par2.30 7
wait 60
shot d10l_sampler.png
turn PRESET 1
expect par2.30 0
turn SELECT 1
expect page Sends
wait 60
shot d10_sends.png
turn SELECT 1
turn PRESET 1
wait 60
shot d11_fx1.png
# a drum key: its black key on the Engine page picks it, the knobs follow
turn ALGO -1
tap EDIT
tapkey b1
wait 60
shot d12_snare_selected.png
spin K1 6
expect par1.d2.k1 85
expect par1.d1.k1 82
wait 60
shot d13_snare_pitch.png
turn SELECT 1
tap SEL
wait 60
shot d14_key_list.png
tap HOME
tap FX
expect page Character
wait 60
shot d15_kit_character.png
tap EDIT
