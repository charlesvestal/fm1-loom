expect par2.x2 100
expect par8.x1 52
expect par1.e2 33
expect name2 114
expect name8 97
expect par1.fine 64
expect par2.fine 64
expect par8.fine 64
# a format 18 project with PR #13's random player (tests/fixtures/make_v18.xy): the tracks a byte longer (TP_RUP), the
