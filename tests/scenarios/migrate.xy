# a project saved by 0.5-beta (format 10: 16 scenes, no kit mutes; tests/fixtures/make_v10.xy) loads: its notes,
# locks, tempo, scenes and song as they were, the other 16 scenes empty, MIDI OUT on for every track; it is this format's from its first touch, and
# a kit sound muted in a scene is kept over a restart
storeload tests/fixtures/store_v10.bin
reboot
wait 400
expect note 3 1 9 57
tap GLO
tap SEL
row PROJ 1
tap SEL
wait 400
tap HOME
expect ask 0
expect tempo 97
expect note 2 1 1 60
expect note 2 1 5 64
expect note 2 2 3 67
expect note 1 1 5 1
expect lane 2 1 e1 1
expect used 7
expect sendnotes 1
expect clock 1
expect par1.51 1
expect par2.51 1
expect par8.51 1
scene 3
wait 40
expect mute 2
scene 2
wait 40
expect mute 0
scene 1
turn SELECT 1
expect page Song
turn K1 -5
tap PLAY
bars 0.5
expect scene 1
bars 2
expect scene 3
bars 1
expect scene 2
tap PLAY
reboot
wait 400
expect tempo 97
expect note 2 2 3 67
expect used 7
# a kit sound muted in a scene (T1's black key held, white key 3: the hat), saved, kept
tap HOME
key b0 down
tapkey w2
key b0 up
wait 40
expect mute 0
projsave 1
reboot
wait 400
expect kmute 4
# a format 11 project (32 scenes, one kit mute mask; tests/fixtures/make_v11.xy): scene 20's hat muted on every kit,
# as it was; each kit's own from here
storeload tests/fixtures/store_v11.bin
reboot
wait 400
expect tempo 101
expect note 2 1 1 60
expect used 524291
expect scene 20
expect mute 2
expect kmute1 4
expect kmute2 4
# a format 15 project (the tracks packed; tests/fixtures/make_v15.xy): each track's values and name where they were,
# knit's osc 2 fine at 0 on every track
storeload tests/fixtures/store_v15.bin
reboot
wait 400
expect tempo 103
expect par2.x1 71
expect par2.x2 100
expect par8.x1 52
expect par1.e2 33
expect name2 114
expect name8 97
expect par1.fine 64
expect par2.fine 64
expect par8.fine 64
# a format 18 project with PR #13's random player (tests/fixtures/make_v18.xy): the tracks a byte longer (TP_RUP), the
# one octave knob split into its octaves down and up (14: 0/+2 on T2, 16: -1/+1 on T3), the rest where it was
storeload tests/fixtures/store_v18.bin
reboot
wait 400
expect tempo 97
expect par2.player 4
expect par2.p4 0
expect par2.rup 2
expect par3.p4 1
expect par3.rup 1
expect par1.rup 0
expect par2.x1 61
expect par2.fine 64
# a format 19 project, from before PING WIDTH (tests/fixtures/make_v19.xy): its FX tracks' TP_X1 (33 there, read by
# nothing) made 127, the full bounce it had
storeload tests/fixtures/store_v19.bin
reboot
wait 400
expect tempo 101
expect par11.x1 127
expect par12.x1 127
expect epar11.x1 127

# a format 20 project, from before the arp's dotted speeds and the delay's triplet times (tests/fixtures/make_v20.xy):
# the arp speeds moved to their places now (1/16 4 -> 6, 1/64 8 -> 10, the lock's 1/4T 1 -> 2), the delay's 1/8D (85)
# to the middle of its tenth (108)
storeload tests/fixtures/store_v20.bin
reboot
wait 400
expect tempo 102
expect par1.p1 6
expect par2.p1 10
expect lock 1 1 1 p1 2
expect par11.e1 108
expect epar11.e1 108

# a format 21 project and its presets (format 11), from before knit's Osc 2 page (tests/fixtures/make_v21.xy): the tracks
# two bytes longer (TP_O2WAVE, TP_O2SHAPE), osc 2 on osc 1's wave as it was; the user preset the same, and the user kit
# K8 (format 11 kept its kits nearer the presets) still there
storeload tests/fixtures/store_v21.bin
reboot
wait 400
expect tempo 103
expect par3.engine 0
expect par3.e1 40
expect par3.x1 71
expect par3.x2 90
expect par3.fine 84
expect par3.o2wave 0
expect par3.o2shape 0
expect par3.rup 0
expect par1.d2.model 12
preset 3 reese
expect par3.fine 64
preset 3 U1
expect par3.x1 71
expect par3.fine 84
expect par3.o2wave 0
expect trk 1
param 1 d2.model 0
listen
tap EDIT
tap SEL
row KIT
turn ALGO -1
wait 300
said K8 kit
tap SEL
wait 40
expect par1.d2.model 12
# a format 22 project and its presets (format 12), from before knit's Mod page (tests/fixtures/make_v22.xy): the tracks
# four bytes longer (TP_KSYNC .. TP_KSUB, 0 each: knit as it was), osc 2's wave kept; the user preset the same, and the
# user kit K8 (format 12 kept its kits nearer the presets) still there
storeload tests/fixtures/store_v22.bin
reboot
wait 400
expect tempo 104
expect par3.engine 0
expect par3.e1 40
expect par3.x1 71
expect par3.x2 90
expect par3.fine 84
expect par3.o2wave 2
expect par3.o2shape 64
expect par3.ksync 0
expect par3.ksweep 0
expect par3.kcross 0
expect par3.ksub 0
expect par1.d2.model 12
preset 3 reese
expect par3.o2wave 0
preset 3 U1
expect par3.x1 71
expect par3.fine 84
expect par3.o2wave 2
expect par3.o2shape 64
expect par3.ksync 0
expect trk 1
param 1 d2.model 0
listen
tap EDIT
tap SEL
row KIT
turn ALGO -1
wait 300
said K8 kit
tap SEL
wait 40
expect par1.d2.model 12
# a user preset keeps the Mod page now (presets format 13): saved, restarted, loaded
spin ALGO 2
expect trk 3
param 3 ksync 1
param 3 ksweep 30
param 3 kcross 20
param 3 ksub 3
usersave 3 2
preset 3 reese
expect par3.ksync 0
reboot
wait 400
preset 3 U2
expect par3.ksync 1
expect par3.ksweep 30
expect par3.kcross 20
expect par3.ksub 3
# a format 23 project and its presets (format 13), from before rayon's Ops page (tests/fixtures/make_v23.xy): the
# tracks four bytes longer (TP_ROPS .. TP_RFB: off, rayon as it was), knit's Mod page kept; the user preset the same
storeload tests/fixtures/store_v23.bin
reboot
wait 400
expect tempo 105
expect par3.engine 0
expect par3.x1 71
expect par3.ksync 1
expect par3.ksweep 24
expect par3.kcross 40
expect par3.ksub 2
expect par4.engine 1
expect par4.x1 30
expect par4.rops 0
expect par4.rratio 1
expect par4.rdepth 0
expect par4.rfb 0
preset 3 reese
expect par3.ksync 0
preset 3 U1
expect par3.ksync 1
expect par3.ksweep 24
expect par3.ksub 2
# a user preset keeps rayon's Ops page now (presets format 14): saved, restarted, loaded
param 4 rops 2
param 4 rratio 6
param 4 rdepth 70
param 4 rfb 30
usersave 4 3
preset 4 rayon
expect par4.rops 0
reboot
wait 400
preset 4 U3
expect par4.rops 2
expect par4.rratio 6
expect par4.rdepth 70
expect par4.rfb 30
# a format 24 project and its presets (format 14), from before knit's analog (tests/fixtures/make_v24.xy): the tracks
# a byte longer (TP_KANALOG: 0, knit as it was), knit's Mod and rayon's Ops pages kept; the user preset the same
storeload tests/fixtures/store_v24.bin
reboot
wait 400
expect tempo 106
expect par3.ksync 1
expect par3.ksweep 24
expect par3.kanalog 0
expect par4.engine 1
expect par4.rops 2
expect par4.rratio 6
expect par4.rdepth 70
expect par4.rfb 30
preset 4 rayon
expect par4.rops 0
preset 4 U1
expect par4.rops 2
expect par4.rfb 30
# a user preset keeps knit's analog now (presets format 15)
param 3 kanalog 77
usersave 3 2
preset 3 reese
expect par3.kanalog 0
reboot
wait 400
preset 3 U2
expect par3.kanalog 77
# a format 25 project, from before the tracks' inserts (tests/fixtures/make_v25.xy): the tracks four bytes longer
# (TP_ITYPE, TP_I1..I3: 0, no insert), knit's analog, the character and rayon's Ops page kept
storeload tests/fixtures/store_v25.bin
reboot
wait 400
expect tempo 107
expect par3.kanalog 77
expect par3.ctype 1
expect par3.camt 90
expect par3.itype 0
expect par3.i1 0
expect par4.rops 2
expect par4.rfb 30
expect par4.itype 0
# format 27: the delay's REPEATS converted (before: the feedback 0.95 x / 127; FX I's default 56 is 0.419, 56 now),
# WOBBLE and SMEAR (FX I's x2, x3) 0
expect par11.e3 56
expect par11.x2 0
expect par11.x3 0
