expect par8.s1k3 99
expect par8.itype 13
expect par8.s2mix 77
expect par8.s2x1 50
param 1 itype 0
param 1 s1k3 0
expect page Steps
expect trk 8
turn ALGO -7
expect trk 1
tap EDIT
tap SEL
row KIT
turn ALGO -1
tap SEL
wait 40
