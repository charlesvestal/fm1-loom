param 1 ctype 0
param 1 itype 0
expect trk 7
turn ALGO -6
expect trk 1
tap EDIT
tap SEL
row KIT
turn ALGO -8
tap SEL
wait 40
said K1
expect par1.ctype 4
expect par1.camt 80
expect par1.itype 0
expect par1.s2mix 127
# format 28 and presets 17 kept as they are: both slots of a user kit and a user preset, a restart, back
param 1 itype 10
param 1 i2 90
param 1 s1k3 33
tap SEL
row SAVE KIT
turn ALGO 7
wait 300
tap SEL
wait 40
said KIT SAVED
param 8 itype 13
param 8 s2mix 77
param 8 s2x1 50
param 8 ctype 2
param 8 s1k3 99
tap SEQ
expect page Steps
turn ALGO 7
expect trk 8
usersave 8 5
projsave 1 v28_test
reboot
wait 400
expect par8.itype 13
expect par8.s2mix 77
expect par8.s2x1 50
expect par8.s1k3 99
expect par1.itype 10
expect par1.s1k3 33
preset 8 knit
expect par8.itype 0
