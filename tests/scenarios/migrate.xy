expect par7.itype 14
expect par7.i1 1
expect par7.i2 60
expect par7.i3 0
expect par7.s2mix 100
# the kit: crush (4), the tremolo (10) wet
expect par1.ctype 4
expect par1.camt 80
expect par1.itype 10
expect par1.i2 100
expect par1.s2mix 127
