# WOBBLE and SMEAR (FX I's x2, x3) 0
expect par11.ctone 56
expect par11.s1x3 0
expect par11.s1x4 0
# a format 27 project and its presets (format 16), from before the one effects list (tests/fixtures/make_v27.xy): the
# character slot 1 (its types the catalog's numbers), the insert slot 2 (its knobs and mix moved: project.c
# old_insert), their locks with them; the new values at their defaults
storeload tests/fixtures/store_v27.bin
reboot
wait 400
listen
expect tempo 112
# track 3: drive (1), its knobs kept; chorus (13): its rate the send's nearest (46), depth, the send's feedback (20),
# its mix the slot's (90), fully wide (its extra); its mix's lock moved to the slot's mix, the fold's lock (3)
expect par3.ctype 1
expect par3.camt 90
expect par3.ctone 40
expect par3.cmix 100
expect par3.s1k3 0
expect par3.itype 13
expect par3.i1 46
expect par3.i2 70
expect par3.i3 20
expect par3.s2mix 90
expect par3.s2x1 127
expect lock 3 1 1 s2mix 40
expect lock 3 1 1 i3 -1
expect lock 3 1 2 ctype 3
# track 4: ring (5); rumble (17): decay, tone, its mix the slot's
expect par4.ctype 5
expect par4.camt 50
expect par4.itype 17
expect par4.i1 60
expect par4.i2 70
expect par4.i3 0
expect par4.s2mix 80
# track 5: the phaser (11): the send's centre (50), depth, its rate the send's nearest (40), feedback its extra, wet
expect par5.itype 11
expect par5.i1 50
expect par5.i2 90
expect par5.i3 40
expect par5.s2x1 60
expect par5.s2mix 127
# track 6: the echo the delay (16): 1/8D (108), its feedback as repeats (75), its tone 64, its mix; its time's lock 1/8
