# a project saved by 0.5-beta (format 10: 16 scenes, no kit mutes; tests/fixtures/make_v10.xy) loads: its notes,
# locks, tempo, scenes and song as they were, the other 16 scenes empty, MIDI OUT on for every track; it is this format's from its first touch, and
# a kit sound muted in a scene is kept over a restart
storeload tests/fixtures/store_v10.bin
reboot
wait 400
expect note 3 1 9 57
tap HOME
tap SEL
row LOAD PROJECT
wait 40
turn ALGO -1
tap SEL
wait 400
expect ask 0
expect tempo 97
expect note 2 1 1 60
expect note 2 1 5 64
expect note 2 2 3 67
expect note 1 1 5 1
expect lane 2 1 e1 1
expect used 7
expect sendnotes 1
expect clock 1
expect par1.51 1
expect par2.51 1
expect par8.51 1
scene 3
wait 40
expect mute 2
scene 2
wait 40
expect mute 0
scene 1
turn SELECT 1
expect page Song
turn K1 -5
tap PLAY
bars 0.5
expect scene 1
bars 2
expect scene 3
bars 1
expect scene 2
tap PLAY
reboot
wait 400
expect tempo 97
expect note 2 2 3 67
expect used 7
# a kit sound muted in a scene (T1's black key held, white key 3: the hat), saved, kept
tap HOME
key b0 down
tapkey w2
key b0 up
wait 40
expect mute 0
projsave 1
reboot
wait 400
expect kmute 4
# a format 11 project (32 scenes, one kit mute mask; tests/fixtures/make_v11.xy): scene 20's hat muted on every kit,
# as it was; each kit's own from here
storeload tests/fixtures/store_v11.bin
reboot
wait 400
expect tempo 101
expect note 2 1 1 60
expect used 524291
expect scene 20
expect mute 2
expect kmute1 4
expect kmute2 4
# a format 15 project (the tracks packed; tests/fixtures/make_v15.xy): each track's values and name where they were,
# knit's osc 2 fine at 0 on every track
storeload tests/fixtures/store_v15.bin
reboot
wait 400
expect tempo 103
expect par2.x1 71
expect par2.x2 100
expect par8.x1 52
expect par1.e2 33
expect name2 114
expect name8 97
expect par1.fine 64
expect par2.fine 64
expect par8.fine 64
# a format 18 project with PR #13's random player (tests/fixtures/make_v18.xy): the tracks a byte longer (TP_RUP), the
# one octave knob split into its octaves down and up (14: 0/+2 on T2, 16: -1/+1 on T3), the rest where it was
storeload tests/fixtures/store_v18.bin
reboot
wait 400
expect tempo 97
expect par2.player 4
expect par2.p4 0
expect par2.rup 2
expect par3.p4 1
expect par3.rup 1
expect par1.rup 0
expect par2.x1 61
expect par2.fine 64
# a format 19 project, from before PING WIDTH (tests/fixtures/make_v19.xy): its FX tracks' TP_X1 (33 there, read by
# nothing) made 127, the full bounce it had
storeload tests/fixtures/store_v19.bin
reboot
wait 400
expect tempo 101
expect par11.x1 127
expect par12.x1 127
expect epar11.x1 127
