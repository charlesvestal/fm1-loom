# kits (a kit track's SELECT list on Engine): KIT loads a factory kit (Loom, tools/gen_kits.py's) or a user
# kit (K1..K8, the list's last eight: turned to from Loom backward, -8 .. -1);
# SAVE KIT keeps the track's kit in a user slot (asking before replacing one), in flash with the user presets: a
# restart keeps it, and loading a kit keeps the track's mix
wait 300
listen
expect trk 1
tap EDIT
expect page Engine
param 1 level 90
# Nylon: the x models (x kick, x clap, x tom)
tap SEL
row KIT
turn ALGO 1
tap SEL
wait 40
said Nylon
expect par1.d1.model 11
expect par1.d1.k1 36
expect par1.d5.k1 97
expect par1.d6.model 15
expect par1.level 90
expect par1.engine 8
# into K1 (empty: no question)
tap SEL
row SAVE KIT
tap SEL
wait 40
said KIT SAVED
expect ask 0
# Loom, then K1 back
tap SEL
row KIT
turn ALGO -1
tap SEL
wait 40
expect par1.d1.model 0
tap SEL
row KIT
turn ALGO -8
tap SEL
wait 40
said K1
expect par1.d1.model 11
expect par1.d5.k1 97
reboot
wait 300
expect par1.d1.model 0
tap EDIT
tap SEL
row KIT
turn ALGO -8
tap SEL
wait 40
expect par1.d1.model 11
# changed and saved over K1: asked first
param 1 d1.model 0
tap SEL
row SAVE KIT
tap SEL
wait 40
expect ask 1
tap SEL
wait 40
expect ask 0
said KIT SAVED
tap SEL
wait 40
shot kits_list.png
# the presets as an older version kept them (format 7, tests/fixtures/make_presets_v7.py: user preset U1, no kits)
# put back: the kits empty, K1 saved beside U1 (backup out:v8.bkp holds both)
tap HOME
wait 40
restore tests/fixtures/presets_v7.bkp
expect restore_rc 0
wait 300
tap EDIT
tap SEL
row SAVE KIT
wait 300
said K1 (empty)
tap SEL
wait 40
said KIT SAVED
backup out:v8.bkp
