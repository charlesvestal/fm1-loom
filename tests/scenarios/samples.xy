# the kit's keys, each with its own envelope and filter (ENV: Envelope, Filter, Kit env, Kit filter); a lock on a
# step reaching the step's key; the sample model on a key; the sample engine on track 3 with its presets and
# the user bank (build/gen/user_bank.bin, made by tests/run_tests.sh with tools/loom_samples.py); WAVs of it all
# (indices: TP_DRUM(key, DP_*) = 48 + key * 18 + DP_*: the snare's decay 77, its filter type 83)
wait 300
expect trk 1
tap ENV
expect page Envelope
tapkey b1
wait 40
shot kit_key_env.png
spin K3 -40
spin K2 20
spin K1 15
expect par1.d2.decay 87
wait 40
shot kit_key_env_shaped.png
turn SELECT 1
expect page Filter
wait 40
shot kit_key_filter_off.png
turn PRESET 1
expect par1.d2.ftype 1
spin K1 -60
spin K2 90
spin K3 40
spin K4 30
wait 40
shot kit_key_filter.png
turn PRESET 1
expect par1.d2.ftype 2
wait 40
shot kit_key_filter_hp.png
turn PRESET 1
expect par1.d2.ftype 3
wait 40
shot kit_key_filter_bp.png
turn PRESET 1
turn PRESET 1
expect par1.d2.ftype 1
tap SEL
wait 40
shot kit_key_filter_list.png
tap HOME
turn SELECT 1
wait 40
shot kit_env.png
spin K4 20
expect par1.12 84
turn SELECT 1
wait 40
shot kit_filter.png
turn PRESET 1
expect par1.21 0
wait 40
shot kit_filter_off.png
turn PRESET 1
expect par1.21 4
turn SELECT 1
expect page Envelope
# a beat with the shaped snare, recorded
tap SEQ
tapkey b0
tapkey w0
tapkey w4
tapkey w8
tapkey w12
tapkey b1
tapkey w4
tapkey w12
wav kit_beat.wav
tap PLAY
wait 2200
tap PLAY
wait 500
wavstop
# a lock: hold step 13 (the snare's), ENV: the snare's envelope, its decay locked short there
key w12 down
wait 100
tap ENV
wait 40
shot kit_lock_env.png
spin K3 -50
key w12 up
wait 40
shot kit_lock_steps.png
# the sample model on key 11 (fm's): the factory piano, its pitch, reversed
tap EDIT
tapkey b10
turn SELECT 1
spin K1 10
expect par1.d11.model 10
turn SELECT -1
spin K1 5
expect par1.d11.k1 5
spin K4 1
expect par1.d11.k4 1
wait 40
shot kit_sample_key.png
tap SEL
wait 40
shot kit_sample_key_list.png
tap HOME
# the sample engine on track 3: its presets (PRESETS turns them), notes, the picture
spin ALGO 2
expect trk 3
tap EDIT
param 3 0 6
turn PRESET 1
expect par3.0 6
wait 60
shot sample_engine.png
wav sample_presets.wav
tapkey w0
wait 300
tapkey w4
wait 300
tapkey w7
wait 600
turn PRESET 1
wait 60
shot sample_choir.png
key w0 down
key w2 down
key w4 down
wait 1500
key w0 up
key w2 up
key w4 up
wait 800
turn PRESET 1
wait 60
shot sample_pingpong.png
key w4 down
wait 900
key w4 up
wait 400
turn PRESET 1
turn PRESET 1
turn PRESET 1
wait 60
shot sample_reverse.png
tapkey w0
wait 1200
wavstop
spin K4 1
wait 40
shot sample_mode.png
spin K2 40
spin K3 -60
wait 40
shot sample_region.png
tap SEL
wait 40
shot sample_list.png
tap HOME
# the user bank: its samples after the factory's
samples build/gen/user_bank.bin
param 3 1 8
param 3 4 0
wait 60
shot sample_user.png
wav sample_user.wav
tapkey w0
wait 400
tapkey w7
wait 600
wavstop
param 3 1 10
wait 60
shot sample_user_empty.png
listen
where
said sample
